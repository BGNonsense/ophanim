<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="GlyphColor">#FFD20000</Color>
    <Color x:Key="GlyphLightColor">#FFFF2419</Color>
    <Color x:Key="SelectionLightColor">#FFDE3A3A</Color>
    <Color x:Key="OverlayColor">#BB000000</Color>

    <Color x:Key="ControlBackgroundColor">#FF570000</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF301212</Color>

    <Color x:Key="TextColor">#FFFFDEDE</Color>
    <Color x:Key="TextColorDark">#FF5C0000</Color>

    <SolidColorBrush x:Key="TextBrush" Color="#FFD10000"/>
    <SolidColorBrush x:Key="TextBrushDark" Color="#FFB90000"/>
    <SolidColorBrush x:Key="GlyphBrush" Color="#FFFFACAC"/>
    <SolidColorBrush x:Key="GlyphLightBrush" Color="#FFFF443A"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF5B0000" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FF6F0000" />
    <LinearGradientBrush x:Key="SelectionLightBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFAC0000"/>
        <GradientStop Color="#FFFF6262" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OverlayBrush" Color="#80000000"/>
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />

    <sys:Double x:Key="FontSizeSmall">18</sys:Double>
    <sys:Double x:Key="FontSize">22</sys:Double>

    <sys:Double x:Key="FilterPanelWidth">300</sys:Double>
    
    <Style x:Key="TextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="OCR A Extended" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <LinearGradientBrush x:Key="MainBackgourndBrush" EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
        <GradientStop Color="Black" Offset="0.999"/>
        <GradientStop Color="Black"/>
        <GradientStop Color="#FE530000" Offset="0.517"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5" >
        <GradientStop Color="#00091F51" Offset="0"/>
        <GradientStop Color="#000B1027" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" EndPoint="1.5,1" StartPoint="-0.5,0.5">
        <GradientStop Color="#CD440101" Offset="0.45"/>
        <GradientStop Color="#FD340000" Offset="1"/>
        <GradientStop Color="#00440101"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF4F0000"/>
        <GradientStop Color="#FF2D0000" Offset="0.962"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SelectionBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFA40000" Offset="1"/>
        <GradientStop Color="#FFA40000" Offset="0"/>
        <GradientStop Color="Red" Offset="0.497"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#809E0000" Offset="0.253"/>
        <GradientStop Color="#00000000" Offset="1"/>
        <GradientStop Color="#80680000" Offset="0.718"/>
        <GradientStop Color="#F98B0000" Offset="0.416"/>
        <GradientStop Color="#FF7B0000" Offset="0.597"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFD500" />
</ResourceDictionary>