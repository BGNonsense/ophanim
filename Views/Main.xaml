<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid x:Name="PART_ViewHost" Background="{DynamicResource MainBackgourndBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--Issue at the moment, must delete lines 24-39 to edit Main.xaml in Designer. Just copy and paste to a notepad and return the lines when done.-->
                            <!--Ophanim Background - Code Sourced from SaVantCZ (all credit goes to them!)-->
                            <Grid Name="CustomBackgroundVideo" Tag="{DynamicResource BackgroundVideo}" Grid.Row="0" Grid.RowSpan="3">
                                <MediaElement Opacity="1" MediaElementBehaviors.Repeat="True" Stretch="UniformToFill" Source="{ThemeFile 'Video/OphanimBG4K.mp4'}">
                                    <MediaElement.CacheMode>
                                        <BitmapCache RenderAtScale="1"/>
                                    </MediaElement.CacheMode>
                                </MediaElement>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="false">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                            </Grid>

                            <FadeImage x:Name="PART_ImageBackground" Grid.RowSpan="3"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Grid Grid.Row="0" Background="{DynamicResource TopBarBackgroundBrush}"
                                  Height="110">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                            </Grid>

                            <DockPanel Grid.Row="1">
                                <Filters x:Name="PART_ElemFilters"
                                         DockPanel.Dock="Left" Focusable="False" Width="317.737" RenderTransformOrigin="0.5,0.5" >
                                    <Filters.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1"/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Filters.RenderTransform>
                                </Filters>

                                <FiltersAdditional x:Name="PART_ElemFiltersAdditional"
                                                   DockPanel.Dock="Left" Focusable="False" />

                                <ContentControl x:Name="PART_ContentFilterItems"
                                            DockPanel.Dock="Top" Focusable="False" />

                                <ListBoxEx x:Name="PART_ListGameItems" Margin="25,520.145,25,-121.655"
                                           Background="Transparent" BorderThickness="0"
                                           DockPanel.Dock="Right"
                                           KeyboardNavigation.DirectionalNavigation="Once" Width="1577.379" RenderTransformOrigin="0.5,0.5" >
                                    <ListBoxEx.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform AngleX="-0.555"/>
                                            <RotateTransform/>
                                            <TranslateTransform X="-2.99"/>
                                        </TransformGroup>
                                    </ListBoxEx.RenderTransform>
                                </ListBoxEx>
                            </DockPanel>

                            <TextBlock Grid.Row="1" FontSize="40"
                                       Text="{DynamicResource LOCNoGamesFound}"
                                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="343.92,636.6,343.92,175.213" Height="58.187">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid Grid.Row="2" Background="{DynamicResource TopBarBackgroundBrush}"
                              Height="100">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="433,35,10,35" Panel.ZIndex="10">
                                    <!--Install-->
                                    <ButtonEx x:Name="PART_ButtonInstall"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCInstallGame}" />
                                    <!--Play-->
                                    <ButtonEx x:Name="PART_ButtonPlay"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCPlayGame}" />
                                    <!--Details-->
                                    <ButtonEx x:Name="PART_ButtonDetails"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCGameDetails}" />
                                    <!--Options-->
                                    <ButtonEx x:Name="PART_ButtonGameOptions"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCGameOptions}" />
                                    <!--Search-->
                                    <ButtonEx x:Name="PART_ButtonSearch"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCSearchLabel}" />
                                    <!--Filter-->
                                    <ButtonEx x:Name="PART_ButtonFilter"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCFilter}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" x:Name="PART_ElemSearchActive"
                                            VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                            Margin="0,15,0,0">
                                    <TextBlock  FontSize="18"                                                
                                                TextAlignment="Center"
                                                Style="{DynamicResource TextBlockBaseStyle}"
                                                Text="{DynamicResource LOCGameListSearchResults}"/>
                                    <TextBlock  Foreground="White"
                                                TextAlignment="Center"
                                                Style="{DynamicResource TextBlockBaseStyle}"
                                                Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" x:Name="PART_ElemExtraFilterActive"
                                       FontSize="20"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                       TextAlignment="Center"
                                       Style="{DynamicResource TextBlockBaseStyle}"
                                       Text="{DynamicResource LOCGameListExtraFiltered}"/>

                                <StackPanel x:Name="PART_ElemProgressIndicator" Orientation="Horizontal"
                                        Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="PART_TextProgressTooltip" 
                                           Margin="0,0,15,0" FontSize="20" VerticalAlignment="Center"
                                           Style="{DynamicResource TextBlockBaseStyle}"/>
                                    <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False"
                                                Height="38" Width="38" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <FilterPresetSelector x:Name="PART_FilterPresetSelector" Grid.Column="0" Margin="664.8,701.763,619.667,342.037" />
                        <GameDetails x:Name="PART_ElemGameDetails" Grid.RowSpan="3"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <GameStatus x:Name="PART_ElemGameStatus" Grid.RowSpan="3"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <ButtonEx x:Name="PART_ButtonMainMenu" VerticalAlignment="Center"
                                          Style="{DynamicResource ButtonTopMenu}"
                                          Margin="891.507,294.832,892.481,649.157" Height="136.011" MinWidth="32"
                                          Grid.Column="0" RenderTransformOrigin="0.504,0.491">
                            <ButtonEx.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="-0.8" ScaleY="0.8"/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="45"/>
                                    <TranslateTransform X="0.079" Y="-1.491"/>
                                </TransformGroup>
                            </ButtonEx.RenderTransform>
                        </ButtonEx>

                        <TextBlock x:Name="PART_TextClock" Style="{DynamicResource TextBlockBaseStyle}"
                                       FontSize="48" VerticalAlignment="Center" Margin="382.86,397.325,1391.599,637.059"
                                       Grid.Column="0" Height="45.616"/>
                        <Grid Margin="1421.435,393.159,415.044,601.312" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="44.326"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.ColumnSpan="1" Margin="12.876,9.728,20.997,22.457" Source="{ThemeFile Resources/bell.png}" Stretch="Fill" RenderTransformOrigin="0.5,0.5" Grid.Column="0">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="-45"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <TextBlock Text="●" Foreground="{DynamicResource GlyphBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                FontSize="40" Margin="0,0,36.148,24.281" Height="51.147" Grid.Column="0" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="1" Width="23.181" >
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="-45"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextBlockBaseStyle}" >
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ButtonEx x:Name="PART_ButtonNotifications" VerticalAlignment="Center"
                                Margin="10,8.844,13.335,16.216" Height="60.469" MinWidth="48"
                                Grid.Column="0">
                                <ButtonEx.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonTopMenu}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ButtonEx.Style>
                            </ButtonEx>
                            <ButtonEx x:Name="PART_ButtonProgramUpdate" VerticalAlignment="Center"
                                          Margin="0,0,0,0" Height="82" MinWidth="82"
                                          Style="{DynamicResource ButtonTopMenu}"                                          
                                          Grid.Column="0" Grid.ColumnSpan="1"
                                          >
                                <Image Source="{ThemeFile Resources/update.png}" Stretch="UniformToFill" Height="78" Width="78"/>
                            </ButtonEx>
                        </Grid>
                        <!--Ignore the warnings for this, it will function regardless. Simply remove lines 264 to 291 in order to use Design mode.-->
                        <ButtonEx Command="{PluginSettings Plugin=NowPlaying, Path=OpenDialog}" Margin="327.6,538,1344.133,430.933" Grid.Row="0">
                            <ButtonEx.Style>
                                <Style TargetType="{x:Type ButtonEx}"
        BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility"
          Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginStatus Plugin=NowPlaying_db4e7ade-57fb-426c-8392-60e2347a0209, Status=Installed}"
              	Value="False">
                                            <Setter Property="Visibility"
              Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{PluginSettings Plugin=NowPlaying, Path=IsGameRunning}"
              	Value="False">
                                            <Setter Property="Visibility"
              Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ButtonEx.Style>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="100"
        Height="100"
        Style="{DynamicResource NowPlayingImageStyle}"
        Source="{PluginSettings Plugin=NowPlaying, Path=RunningGame.IconPath}"/>
                                <Image Grid.ColumnSpan="2" Margin="17.729,25.03,-43.325,38.458" Source="{ThemeFile 'Resources/currentgame.png'}" Stretch="Fill" RenderTransformOrigin="0.5,0.5"/>
                            </StackPanel>
                        </ButtonEx>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>